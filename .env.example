# Nebius Token Factory Settings
# Base URL for OpenAI-compatible Nebius Token Factory inference
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Your Nebius Token Factory API Key (Get $25-$50 free credits via Nebius Builder Program)
# Activation Code: NEBIUS DEVPOST GLOBAL26
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here

# NVIDIA Open Models on Nebius Token Factory
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
